<section class='container'>
	<h3 class='page-title'>NDH Query Client</h3>

	<% if @client %>
		<p class="text-success client-connected text-center mb-4">
			Connected to <%= cookies[:server_url] -%>
		</p>
		<table class="table table-dark table-striped">
			<tbody>
				<tr>
					<td><%= @endpoints %> <%= link_to "Endpoints", endpoints_path %></td>
					<td><%= @healthCareServices %> <%= link_to "Healthcare Services", healthcare_services_path %></td>
					<td><%= @insurancePlans %> <%= link_to "Insurance Plans", insurance_plans_path %></td>
				</tr>
				<tr>
					<td><%= @locations %> <%= link_to "Locations", locations_path %></td>
					<td><%= @networks %> <%= link_to "Networks", networks_path %></td>
					<td><%= @organizations %> <%= link_to "Organizations", organizations_path %></td>
				</tr>
				<tr>
					<td><%= @organizationAffiliations %> <%= link_to "Organization Affiliations", organization_affiliations_path %></td>
					<td><%= @practitioners %> <%= link_to "Practitioners", practitioners_path %></td>
					<td><%= @practitionerRoles %> <%= link_to "PractitionerRoles", practitioner_roles_path %></td>
				</tr>
			</tbody>
		</table>

		<div class="card mt-4">
			<div class="card-header">
				<h5 class="mb-0">Example Queries</h5>
			</div>
			<ul class="list-group list-group-flush">
				<li class="list-group-item">
					<%= link_to "Practitioners with an MD qualification", practitioners_path(query_string: 'qualification-code=MD') %>
					<div><small class="text-muted"><code>qualification-code=MD</code></small></div>
				</li>
				<li class="list-group-item">
					<%= link_to "Practitioner roles accepting new patients (with practitioners included)", practitioner_roles_path(query_string: 'new-patient=newpt&_include=PractitionerRole:practitioner') %>
					<div><small class="text-muted"><code>new-patient=newpt&amp;_include=PractitionerRole:practitioner</code></small></div>
				</li>
				<li class="list-group-item">
					<%= link_to "Endpoints with complete verification", endpoints_path(query_string: 'verification-status=complete') %>
					<div><small class="text-muted"><code>verification-status=complete</code></small></div>
				</li>
				<li class="list-group-item">
					<%= link_to "Locations within 20 miles of Helena, MT (59601)", locations_path(query_string: 'address-postalcode=59601&radius=20') %>
					<div><small class="text-muted"><code>address-postalcode=59601&amp;radius=20</code></small></div>
				</li>
				<li class="list-group-item">
					<%= link_to "Organizations in Connecticut", organizations_path(query_string: 'address-state=CT') %>
					<div><small class="text-muted"><code>address-state=CT</code></small></div>
				</li>
			</ul>
		</div>
	<% else %>
		<p class="text-warning client-not-connected text-center mb-4">
			Connect to a FHIR server to begin querying data.
		</p>
	<% end %>

	<section class='row justify-content-center mt-4'>
		<%= form_tag root_path, method: 'get', class: 'd-flex gap-2', id: 'server-form' do %>
			<div class='flex-grow-1'>
				<%= text_field_tag :server_url, (cookies[:server_url] or 'https://ndh-server.fast.hl7.org/fhir'), class: 'form-control', placeholder: 'https://ndh-server.fast.hl7.org/fhir' %>
			</div>
			<%= button_tag class: 'btn btn-primary', id: 'server-url' do %>
				Connect
			<% end %>
		<% end %>
	</section>
</section>
